{
  "health_check": {
    "description": "Test health endpoint",
    "method": "GET",
    "path": "/health",
    "curl": "curl https://YOUR_LAMBDA_URL/health"
  },
  "get_all_users": {
    "description": "Get all users",
    "method": "GET",
